    {
      "name": "00. Auth Setup (Lấy Token kiểm thử)",
      "item": [
        {
          "name": "Login Student (Lấy studentToken)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () { pm.response.to.have.status(200); });",
                  "var json = pm.response.json();",
                  "pm.test(\"Lấy accessToken student thành công\", function () {",
                  "    pm.expect(json.data).to.have.property('accessToken');",
                  "    pm.collectionVariables.set('studentToken', json.data.accessToken);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{studentEmail}}\",\n  \"password\": \"{{studentPassword}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          }
        },
        {
          "name": "Login Admin (Lấy adminToken)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () { pm.response.to.have.status(200); });",
                  "var json = pm.response.json();",
                  "pm.test(\"Lấy accessToken admin thành công\", function () {",
                  "    pm.expect(json.data).to.have.property('accessToken');",
                  "    pm.collectionVariables.set('adminToken', json.data.accessToken);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          }
        }
      ]
    },
    {
      "name": "01. Pagination & Search (P01 - P17)",
      "item": [
        {
          "name": "P01 - GET danh sách mặc định (page=1, limit=10)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 200 OK\", function () { pm.response.to.have.status(200); });",
                  "var json = pm.response.json();",
                  "pm.test(\"data là mảng\", function () { pm.expect(json.data).to.be.an('array'); });",
                  "pm.test(\"Pagination mặc định page=1, limit=10\", function () {",
                  "    pm.expect(json.pagination.page).to.eql(1);",
                  "    pm.expect(json.pagination.limit).to.eql(10);",
                  "    pm.expect(json.pagination).to.have.property('totalItems');",
                  "    pm.expect(json.pagination).to.have.property('totalPages');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/v1/sinh-vien", "host": ["{{baseUrl}}"], "path": ["api", "v1", "sinh-vien"] }
          }
        },
        {
          "name": "P02 - GET page=1&limit=2 (Tối đa 2 bản ghi đầu)",
