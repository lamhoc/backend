                  "pm.test(\"Tối đa 2 bản ghi\", function () { pm.expect(json.data.length).to.be.at.most(2); });",
                  "pm.test(\"Pagination page=1, limit=2\", function () {",
                  "    pm.expect(json.pagination.page).to.eql(1);",
                  "    pm.expect(json.pagination.limit).to.eql(2);",
                  "});",
                  "if (json.data && json.data.length > 0) {",
                  "    pm.collectionVariables.set(\"p02FirstMaSV\", json.data[0].maSV);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/v1/sinh-vien?page=1&limit=2", "host": ["{{baseUrl}}"], "path": ["api", "v1", "sinh-vien"], "query": [{"key": "page", "value": "1"}, {"key": "limit", "value": "2"}] }
