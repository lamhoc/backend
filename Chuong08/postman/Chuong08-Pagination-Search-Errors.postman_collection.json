                  "});",
                  "var p02FirstMaSV = pm.collectionVariables.get(\"p02FirstMaSV\");",
                  "if (p02FirstMaSV && json.data && json.data.length > 0) {",
                  "    pm.test(\"Không trùng bản ghi với trang 1\", function () {",
                  "        var maSVs = json.data.map(function(s) { return s.maSV; });",
