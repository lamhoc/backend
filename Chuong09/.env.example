# Cấu hình cổng ứng dụng Backend
PORT=5000
NODE_ENV=development

# Cấu hình kết nối SQL Server
# Khi chạy Local trực tiếp trên Windows: DB_HOST=127.0.0.1
# Khi chạy qua Docker Compose (Phương án B): DB_HOST=sqlserver
DB_HOST=127.0.0.1
DB_PORT=1433
DB_NAME=QuanLySinhVienDB
DB_USER=sv_app
DB_PASSWORD=REPLACE_WITH_LOCAL_SQL_PASSWORD

# Mật khẩu tài khoản SA cho Docker Compose (MSSQL)
MSSQL_SA_PASSWORD=REPLACE_WITH_STRONG_LOCAL_PASSWORD

# Mã hóa TLS / Chứng chỉ
DB_ENCRYPT=true
DB_TRUST_CERT=true

# Khóa bí mật ký JWT Token
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_EXPIRES_IN="1h"
