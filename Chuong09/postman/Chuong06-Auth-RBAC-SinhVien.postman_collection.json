      "item": [
        {
          "name": "A01 - Register student mới hợp lệ",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function () { pm.response.to.have.status(201); });",
                  "pm.test(\"User được tạo với role student\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.data.role).to.eql('student');",
                  "    pm.expect(json.data).to.not.have.property('passwordHash');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Nguyen Minh An\",\n  \"email\": \"an.lab@example.com\",\n  \"password\": \"SinhVien@123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] }
          }
        },
