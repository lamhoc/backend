          }
        },
        {
          "name": "P09 - GET limit=abc (Chặn 400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Limit chữ trả về 400\", function () { pm.response.to.have.status(400); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/v1/sinh-vien?limit=abc", "host": ["{{baseUrl}}"], "path": ["api", "v1", "sinh-vien"], "query": [{"key": "limit", "value": "abc"}] }
          }
        },
        {
          "name": "P10 - GET limit=51 (Chặn 400)",
          "event": [
            {
              "listen": "test",
              "script": {
