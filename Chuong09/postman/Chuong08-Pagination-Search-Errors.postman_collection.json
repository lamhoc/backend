              }
            }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/v1/sinh-vien?limit=51", "host": ["{{baseUrl}}"], "path": ["api", "v1", "sinh-vien"], "query": [{"key": "limit", "value": "51"}] }
          }
        },
        {
          "name": "P11 - GET search=Anh (Lọc theo tên)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/v1/sinh-vien?search=Anh", "host": ["{{baseUrl}}"], "path": ["api", "v1", "sinh-vien"], "query": [{"key": "search", "value": "Anh"}] }
          }
        },
        {
          "name": "P13 - GET search=khongco (Trả rỗng và totalItems=0)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });",
                  "var json = pm.response.json();",
                  "pm.expect(json.data).to.eql([]);",
                  "pm.expect(json.pagination.totalItems).to.eql(0);",
                  "pm.expect(json.pagination.totalPages).to.eql(0);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/v1/sinh-vien?search=khongco", "host": ["{{baseUrl}}"], "path": ["api", "v1", "sinh-vien"], "query": [{"key": "search", "value": "khongco"}] }
          }
        }
      ]
    },
    {
      "name": "02. Error Handling (E01 - E10)",
      "item": [
        {
          "name": "E01 - Query page âm (Bắt 400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 400\", function () { pm.response.to.have.status(400); });",
                  "var json = pm.response.json();",
                  "pm.expect(json.success).to.eql(false);",
                  "pm.expect(json.status).to.eql(400);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/v1/sinh-vien?page=-5", "host": ["{{baseUrl}}"], "path": ["api", "v1", "sinh-vien"], "query": [{"key": "page", "value": "-5"}] }
          }
        },
        {
          "name": "E03 - GET sinh viên không tồn tại (Bắt 404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 404\", function () { pm.response.to.have.status(404); });",
                  "var json = pm.response.json();",
                  "pm.expect(json.status).to.eql(404);",
                  "pm.expect(json.message).to.include(\"Không tìm thấy\");"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/v1/sinh-vien/SV999", "host": ["{{baseUrl}}"], "path": ["api", "v1", "sinh-vien", "SV999"] }
          }
        },
        {
          "name": "E04 - Gọi URL không tồn tại (Fallback 404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 404\", function () { pm.response.to.have.status(404); });",
                  "var json = pm.response.json();",
                  "pm.expect(json.status).to.eql(404);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/duong-dan-khong-co", "host": ["{{baseUrl}}"], "path": ["duong-dan-khong-co"] }
          }
        }
      ]
    }
  ]
}

