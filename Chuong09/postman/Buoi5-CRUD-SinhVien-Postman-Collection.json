    {
      "name": "Chuong 5 - Validation & Morgan (V01-V12)",
      "description": "Chạy các request theo thứ tự. Trước khi chạy trên SQL Server thử nghiệm: maLop phải tồn tại, SV006 chưa tồn tại, và database không chứa dữ liệu thật cần bảo vệ. V12 cần restart server thủ công trước khi chạy.",
      "item": [
        {
          "name": "V01 - POST hợp lệ SV006",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/sinh-vien",
            "description": "Cần bảo đảm SV006 chưa tồn tại và maLop trỏ đến lớp thật trong database thử nghiệm.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"maSV\": \"SV006\",\n  \"hoTen\": \"Nguyễn Minh An\",\n  \"email\": \"minhan@example.com\",\n  \"maLop\": \"{{maLop}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('V01 - Trả 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('Body thành công và có SV006', () => { pm.expect(body.success).to.eql(true); pm.expect(body.data.maSV).to.eql('SV006'); });"
