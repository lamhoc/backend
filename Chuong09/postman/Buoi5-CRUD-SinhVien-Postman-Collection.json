              "pm.test('T04 - POST thiếu hoTen trả 400', () => {",
              "  pm.response.to.have.status(400);",
              "  const json = pm.response.json();",
              "  pm.expect(json.success).to.eql(false);",
              "});",
              "const baseUrl = pm.collectionVariables.get('baseUrl');",
              "const invalidId = encodeURIComponent(pm.collectionVariables.get('maSVInvalid'));",
              "pm.sendRequest({ url: `${baseUrl}/api/v1/sinh-vien/${invalidId}`, method: 'GET', header: { Accept: 'application/json' } }, (err, res) => {",
              "  pm.test('T04 - POST sai không tạo bản ghi', () => {",
              "    pm.expect(err).to.eql(null);",
              "    pm.expect(res.code).to.eql(404);",
              "  });",
              "});"
            ]
