{
  "info": {
    "_postman_id": "5d1bbeb5-c3c6-4f14-92d8-9b8c0f049ede",
    "name": "Buoi 5 - CRUD SinhVien + Chuong 5 Validation & Morgan",
    "description": "Collection kiểm thử theo Bài thực hành Chương 4 RESTful CRUD & Swagger. Chạy lần lượt từ T01 đến T12 bằng Collection Runner. Trước khi chạy: bảo đảm SV003, SV004 và SV9999 chưa tồn tại; mã lớp 25CT114 phải hợp lệ trong database. Nếu khác, chỉnh Collection Variables. Database dùng SQL Server phải cho phép tạo/xóa sinh viên thử nghiệm. Một số test dùng pm.sendRequest để GET xác minh dữ liệu mà không thêm request ngoài 12 test case.\n\nChuong 5: chay folder \"Chuong 5 - Validation & Morgan (V01-V12)\" sau khi cau hinh baseUrl, maLop hop le va database thu nghiem. V01 can SV006 chua ton tai; V08 can V01 da tao SV006. V12 nen chay rieng sau khi restart server.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "T01 - GET danh sách",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/sinh-vien",
        "description": "Kỳ vọng 200; success=true; data là mảng."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('T01 - GET danh sách trả 200', () => {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test('T01 - success=true và data là mảng', () => {",
              "  const json = pm.response.json();",
              "  pm.expect(json.success).to.eql(true);",
              "  pm.expect(json.data).to.be.an('array');",
              "});"
            ]
          }
        }
      ],
      "response": []
    },
