        "body": {
          "mode": "raw",
          "raw": "{\n  \"maSV\": \"{{maSV}}\",\n  \"hoTen\": \"{{hoTen}}\",\n  \"email\": \"{{email}}\",\n  \"maLop\": \"{{maLop}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('T02 - POST hợp lệ trả 201', () => {",
              "  pm.response.to.have.status(201);",
              "  const json = pm.response.json();",
              "  pm.expect(json.success).to.eql(true);",
              "  pm.expect(json.data.maSV).to.eql(pm.collectionVariables.get('maSV'));",
              "  pm.expect(json.data.hoTen).to.eql(pm.collectionVariables.get('hoTen'));",
              "  pm.expect(json.data.email).to.eql(pm.collectionVariables.get('email'));",
              "  pm.expect(json.data.maLop).to.eql(pm.collectionVariables.get('maLop'));",
              "});"
