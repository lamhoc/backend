{
  "info": {
    "_postman_id": "ch09-api-testing-security",
    "name": "Chương 09 - API Testing & Security",
    "description": "Collection kiểm thử Login, Rate Limit 5 request/60 giây, Helmet headers, Profile không token và RBAC Student DELETE. Chọn Environment trước khi chạy. Để xác minh 429, chỉ chạy riêng request 'Login - Rate Limit 6 lần' trong Collection Runner với Iterations = 6, sau khi đặt rateLimitAttempt=0 và bảo đảm cửa sổ limiter đã được reset.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "loginEmail", "value": "" },
    { "key": "loginPassword", "value": "" },
    { "key": "studentEmail", "value": "" },
    { "key": "studentPassword", "value": "" },
    { "key": "studentMaSV", "value": "" },
    { "key": "token", "value": "" },
    { "key": "studentToken", "value": "" },
    { "key": "rateLimitAttempt", "value": "0" }
  ],
  "item": [
    {
      "name": "01. Authentication & Rate Limit",
      "item": [
        {
          "name": "Login - Thành công, lưu token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login trả HTTP 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response thành công đúng cấu trúc và lưu accessToken', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.success).to.eql(true);",
                  "    pm.expect(body.message).to.be.a('string').and.not.empty;",
                  "    pm.expect(body.data).to.be.an('object');",
                  "    pm.expect(body.data.accessToken).to.be.a('string').and.not.empty;",
                  "    pm.expect(body.data.tokenType).to.eql('Bearer');",
                  "    pm.environment.set('token', body.data.accessToken);",
                  "    if (body.data.user && body.data.user.role === 'student') {",
                  "        pm.environment.set('studentToken', body.data.accessToken);",
                  "    }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{loginEmail}}\",\n  \"password\": \"{{loginPassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Login Student - Lưu studentToken cho RBAC",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login Student trả HTTP 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Tài khoản có role student và lưu token', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.success).to.eql(true);",
                  "    pm.expect(body.data.user.role).to.eql('student');",
                  "    pm.expect(body.data.accessToken).to.be.a('string').and.not.empty;",
                  "    pm.environment.set('studentToken', body.data.accessToken);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{studentEmail}}\",\n  \"password\": \"{{studentPassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Login - Rate Limit 6 lần",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const attempt = (Number(pm.environment.get('rateLimitAttempt')) || 0) + 1;",
                  "pm.environment.set('rateLimitAttempt', String(attempt));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const attempt = Number(pm.environment.get('rateLimitAttempt'));",
                  "",
                  "if (attempt <= 5) {",
                  "    pm.test(`Login lần ${attempt}/5 chưa vượt hạn mức`, function () {",
                  "        pm.response.to.have.status(200);",
                  "        pm.expect(pm.response.json().success).to.eql(true);",
                  "    });",
                  "} else {",
                  "    pm.test('Login lần thứ 6 trả HTTP 429 và đúng response lỗi', function () {",
                  "        pm.response.to.have.status(429);",
                  "        const body = pm.response.json();",
                  "        pm.expect(body.success).to.eql(false);",
                  "        pm.expect(body.status).to.eql(429);",
                  "        pm.expect(body.message).to.be.a('string').and.not.empty;",
                  "        pm.expect(body.data).to.eql(null);",
                  "    });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{loginEmail}}\",\n  \"password\": \"{{loginPassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "02. SinhVien, Helmet & RBAC",
      "item": [
        {
          "name": "GET danh sách - Pagination & Helmet headers",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('GET danh sách trả HTTP 200, data[] và pagination', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.success).to.eql(true);",
                  "    pm.expect(body.data).to.be.an('array');",
                  "    pm.expect(body.pagination).to.be.an('object');",
                  "    pm.expect(body.pagination.page).to.eql(1);",
                  "    pm.expect(body.pagination.limit).to.eql(10);",
                  "    pm.expect(body.pagination.totalItems).to.be.a('number');",
                  "});",
                  "",
                  "pm.test('Helmet: X-Content-Type-Options', function () {",
                  "    pm.expect(pm.response.headers.get('X-Content-Type-Options')).to.eql('nosniff');",
                  "});",
                  "",
                  "pm.test('Helmet: Content-Security-Policy', function () {",
                  "    pm.expect(pm.response.headers.get('Content-Security-Policy')).to.be.a('string').and.not.empty;",
                  "});",
                  "",
                  "pm.test('Helmet: X-Frame-Options và Referrer-Policy', function () {",
                  "    pm.expect(pm.response.headers.get('X-Frame-Options')).to.be.a('string').and.not.empty;",
                  "    pm.expect(pm.response.headers.get('Referrer-Policy')).to.be.a('string').and.not.empty;",
                  "});",
                  "",
                  "pm.test('Helmet: Strict-Transport-Security khi gọi qua HTTPS', function () {",
                  "    const requestUrl = pm.request.url.toString();",
                  "    const hsts = pm.response.headers.get('Strict-Transport-Security');",
                  "    if (requestUrl.startsWith('https://')) {",
                  "        pm.expect(hsts).to.match(/max-age=\\d+/i);",
                  "    } else {",
                  "        console.info('Bỏ qua assertion HSTS trên HTTP; hãy chạy lại bằng HTTPS để kiểm tra header này.');",
                  "    }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/sinh-vien?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "sinh-vien"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "GET Profile - Không gửi Bearer Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Profile không token trả HTTP 401 và response lỗi chuẩn', function () {",
                  "    pm.response.to.have.status(401);",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.success).to.eql(false);",
                  "    pm.expect(body.status).to.eql(401);",
                  "    pm.expect(body.message).to.be.a('string').and.not.empty;",
                  "    pm.expect(body.data).to.eql(null);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "auth": { "type": "noauth" },
            "url": {
              "raw": "{{baseUrl}}/api/auth/profile",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "profile"]
            }
          }
        },
        {
          "name": "DELETE SinhVien - Student bị RBAC chặn 403",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Student bị từ chối DELETE với HTTP 403 và response lỗi chuẩn', function () {",
                  "    pm.response.to.have.status(403);",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.success).to.eql(false);",
                  "    pm.expect(body.status).to.eql(403);",
                  "    pm.expect(body.message).to.be.a('string').and.not.empty;",
                  "    pm.expect(body.data).to.eql(null);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{studentToken}}", "type": "string" }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/sinh-vien/{{studentMaSV}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "sinh-vien", "{{studentMaSV}}"]
            }
          }
        }
      ]
    }
  ]
}
