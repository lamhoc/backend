        {
          "name": "D06 - Rate Limit Docker",
          "description": "Dùng đúng cách chạy Runner S01-S02: chỉ request này, Iterations=6, rateLimitAttempt=0; chờ qua cửa sổ 60 giây nếu đã gửi Login trước đó.",
          "event": [
            { "listen": "prerequest", "script": { "type": "text/javascript", "exec": ["const attempt = (Number(pm.environment.get('rateLimitAttempt')) || 0) + 1;", "pm.environment.set('rateLimitAttempt', String(attempt));"] } },
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "const attempt = Number(pm.environment.get('rateLimitAttempt'));",
              "if (attempt < 6) { pm.test(`D06 - Login lần ${attempt} được xử lý`, function () { pm.response.to.have.status(200); }); }",
              "else { pm.test('D06 - Lần 6 bị chặn 429', function () { pm.response.to.have.status(429); pm.expect(pm.response.json().status).to.eql(429); }); }"
            ] } }
          ],
