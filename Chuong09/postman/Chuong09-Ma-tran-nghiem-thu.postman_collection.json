  "item": [
    {
      "name": "00. Chuẩn bị token",
      "description": "Chạy Login Admin và Login Student trước các ca cần quyền. Chỉ nhập thông tin tài khoản trong Environment/Variables; không ghi mật khẩu hay token vào script.",
      "item": [
        {
          "name": "Login Admin - Lưu adminToken",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Admin login trả 200', function () { pm.response.to.have.status(200); });",
            "const body = pm.response.json();",
            "pm.test('Lưu accessToken của Admin', function () {",
            "    pm.expect(body.success).to.eql(true);",
            "    pm.expect(body.data.user.role).to.eql('admin');",
            "    pm.expect(body.data.accessToken).to.be.a('string').and.not.empty;",
            "    pm.environment.set('adminToken', body.data.accessToken);",
            "});"
          ] } }],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/auth/login" }
        },
        {
          "name": "Login Student - Lưu studentToken",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Student login trả 200', function () { pm.response.to.have.status(200); });",
            "const body = pm.response.json();",
            "pm.test('Lưu accessToken của Student', function () {",
            "    pm.expect(body.success).to.eql(true);",
            "    pm.expect(body.data.user.role).to.eql('student');",
            "    pm.expect(body.data.accessToken).to.be.a('string').and.not.empty;",
            "    pm.environment.set('studentToken', body.data.accessToken);",
            "});"
          ] } }],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{studentEmail}}\",\n  \"password\": \"{{studentPassword}}\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/auth/login" }
        }
      ]
    },
    {
      "name": "01. Security S01-S07",
      "item": [
        {
          "name": "S01-S02 - Rate Limit: 5 lần thường, lần 6 là 429",
          "description": "Collection Runner: chọn riêng request này, Iterations=6. Đặt rateLimitAttempt=0; dùng cùng client/IP; không có request Login khác trong 60 giây trước đó.",
          "event": [
            { "listen": "prerequest", "script": { "type": "text/javascript", "exec": [
              "const attempt = (Number(pm.environment.get('rateLimitAttempt')) || 0) + 1;",
              "pm.environment.set('rateLimitAttempt', String(attempt));"
            ] } },
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "const attempt = Number(pm.environment.get('rateLimitAttempt'));",
              "if (attempt <= 5) {",
              "    pm.test(`S01 - Login lần ${attempt}/5 được xử lý`, function () {",
              "        pm.response.to.have.status(200);",
              "    });",
              "} else {",
              "    pm.test('S02 - Lần thứ 6 nhận HTTP 429 và body lỗi chuẩn', function () {",
              "        pm.response.to.have.status(429);",
              "        const body = pm.response.json();",
              "        pm.expect(body.success).to.eql(false);",
              "        pm.expect(body.status).to.eql(429);",
              "        pm.expect(body.message).to.be.a('string').and.not.empty;",
              "        pm.expect(body.data).to.eql(null);",
              "    });",
              "}"
            ] } }
          ],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/auth/login" }
        },
        {
          "name": "S03 - Login sau khi cửa sổ 60 giây hết hạn",
          "description": "Chạy riêng sau ít nhất 60 giây kể từ khi vượt hạn mức; đặt rateLimitAttempt=0. Kỳ vọng hạn mức mới cho phép request.",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('S03 - Login sau reset không bị giới hạn', function () {",
            "    pm.response.to.have.status(200);",
            "});"
          ] } }],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/auth/login" }
        },
        {
          "name": "S04 - GET SinhVien không bị Login limiter",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('S04 - GET danh sách vẫn trả 200', function () { pm.response.to.have.status(200); });",
            "pm.expect(pm.response.json().data).to.be.an('array');"
          ] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/sinh-vien?page=1&limit=10" }
        },
        {
          "name": "S05 - Helmet security headers",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('S05 - X-Content-Type-Options nosniff', function () { pm.expect(pm.response.headers.get('X-Content-Type-Options')).to.eql('nosniff'); });",
            "pm.test('S05 - Content-Security-Policy có giá trị', function () { pm.expect(pm.response.headers.get('Content-Security-Policy')).to.be.a('string').and.not.empty; });",
            "pm.test('S05 - X-Frame-Options và Referrer-Policy có giá trị', function () {",
            "    pm.expect(pm.response.headers.get('X-Frame-Options')).to.be.a('string').and.not.empty;",
            "    pm.expect(pm.response.headers.get('Referrer-Policy')).to.be.a('string').and.not.empty;",
            "});",
            "pm.test('S05 - HSTS khi kết nối HTTPS', function () {",
            "    if (pm.request.url.toString().startsWith('https://')) {",
            "        pm.expect(pm.response.headers.get('Strict-Transport-Security')).to.match(/max-age=\\d+/i);",
            "    } else { console.info('HSTS chỉ được kiểm tra khi request dùng HTTPS.'); }",
            "});"
          ] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/sinh-vien" }
        },
        {
          "name": "S06 - Login sai: 401, không có accessToken",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('S06 - Login sai trả 401 và body lỗi chuẩn', function () {",
            "    pm.response.to.have.status(401);",
            "    const body = pm.response.json();",
            "    pm.expect(body.success).to.eql(false);",
            "    pm.expect(body.status).to.eql(401);",
            "    pm.expect(body.message).to.be.a('string').and.not.empty;",
            "    pm.expect(body.data).to.eql(null);",
            "    pm.expect(body).not.to.have.nested.property('data.accessToken');",
            "});"
          ] } }],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{wrongPassword}}\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/auth/login" }
        },
        {
          "name": "S07 - Student DELETE bị RBAC từ chối 403",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('S07 - Student nhận HTTP 403 và body lỗi', function () {",
            "    pm.response.to.have.status(403);",
            "    const body = pm.response.json();",
            "    pm.expect(body.success).to.eql(false);",
            "    pm.expect(body.status).to.eql(403);",
            "    pm.expect(body.message).to.be.a('string').and.not.empty;",
            "    pm.expect(body.data).to.eql(null);",
            "});"
          ] } }],
          "request": { "method": "DELETE", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{studentToken}}", "type": "string" }] }, "url": "{{baseUrl}}/api/v1/sinh-vien/{{studentMaSV}}" }
        }
      ]
    },
