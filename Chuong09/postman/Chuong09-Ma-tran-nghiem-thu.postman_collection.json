          ] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/sinh-vien?search={{searchTerm}}" }
        },
        {
          "name": "R03.1 - Validation page=-1 trả 400",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('R03.1 - Validation trả HTTP 400 và lỗi chuẩn', function () {",
            "    pm.response.to.have.status(400);",
            "    const body = pm.response.json();",
            "    pm.expect(body.success).to.eql(false);",
            "    pm.expect(body.status).to.eql(400);",
            "    pm.expect(body.message).to.be.a('string').and.not.empty;",
            "    pm.expect(body.data).to.eql(null);",
            "});"
          ] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/sinh-vien?page=-1" }
        },
        {
          "name": "R03.2 - GET mã sinh viên không tồn tại trả 404",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('R03.2 - Not found trả 404 và lỗi chuẩn', function () {",
            "    pm.response.to.have.status(404);",
            "    const body = pm.response.json();",
            "    pm.expect(body.success).to.eql(false);",
            "    pm.expect(body.status).to.eql(404);",
            "    pm.expect(body.message).to.be.a('string').and.not.empty;",
            "    pm.expect(body.data).to.eql(null);",
            "});"
          ] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/sinh-vien/SV999" }
        },
        {
          "name": "R04.1 - Upload Avatar (chọn file trong Postman)",
          "description": "Authorization Bearer {{studentToken}}. Body form-data: field avatar, chọn file JPEG/PNG hợp lệ nhỏ hơn 2MB. Chọn file cục bộ sau khi import collection.",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('R04.1 - Upload trả 200 và avatarUrl', function () {",
            "    pm.response.to.have.status(200);",
            "    const body = pm.response.json();",
            "    pm.expect(body.success).to.eql(true);",
            "    pm.expect(body.data.avatarUrl).to.include('/uploads/');",
            "    pm.environment.set('avatarPath', body.data.avatarUrl);",
            "});"
          ] } }],
          "request": { "method": "POST", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{studentToken}}", "type": "string" }] }, "body": { "mode": "formdata", "formdata": [{ "key": "avatar", "type": "file", "src": [] }] }, "url": "{{baseUrl}}/api/auth/me/avatar" }
        },
        {
          "name": "R04.2 - GET Avatar đã upload",
          "description": "Chạy sau R04.1; xác nhận file được phục vụ. Persistence sau restart/recreate cần chạy lại request sau khi khởi động container.",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('R04.2 - File Avatar truy cập được', function () {",
            "    pm.expect(pm.response.code).to.eql(200);",
            "    pm.expect(pm.response.headers.get('Content-Type')).to.match(/^image\\//i);",
            "});"
          ] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}{{avatarPath}}" }
        }
      ]
    }
  ]
